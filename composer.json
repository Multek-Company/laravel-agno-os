{
    "name": "multek/laravel-agno-os",
    "description": "A Laravel client and JWT token factory for Agno AgentOS 3.",
    "keywords": ["agno", "agentos", "laravel", "ai", "agents", "jwt"],
    "license": "MIT",
    "authors": [
        {
            "name": "Multek"
        }
    ],
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^6.11",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Multek\\AgnoOS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Multek\\AgnoOS\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Multek\\AgnoOS\\AgnoOSServiceProvider"
            ],
            "aliases": {
                "AgnoOS": "Multek\\AgnoOS\\Facades\\AgnoOS"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
